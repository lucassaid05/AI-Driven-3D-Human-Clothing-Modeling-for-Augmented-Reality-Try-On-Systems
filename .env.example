## Local server
# PORT=8000
#
# Where generation outputs go (will create generated/task_<id>/...)
# OUTPUT_DIR=./generated
#
# CPU or CUDA device for inference
# DEVICE=cuda
#
# Optional: expose Python server over HTTPS for mobile getUserMedia on LAN.
# Provide paths to PEM files (e.g. mkcert outputs).
# HTTPS_CERT=
# HTTPS_KEY=
#
# If you run the Vite dev server on a different port, tell the API.
# TRYON_VITE_PORT=5173

## Pix2Surf / SMPL / Blender (paths are machine-specific)
# PIX2SURF_ROOT=
# SMPL_PKL=
# BLENDER_BIN=
# GARMENT_OBJ=shirts.obj

## Generation tuning (optional)
# GEN_TIMEOUT_SEC=
# SUBDIVIDE_ITERS=
# SMOOTH_ITERS=
# PREP_MIN_EDGE=
#
# Texture mode: direct | hybrid | pix2surf
# TEXTURE_MODE=direct

## Tile alignment (optional)
# TILE_ALIGN_TEMPLATE=1
# TILE_SHOULDER_FRAC=0.12
# TILE_HEM_FRAC=0.92
