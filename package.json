{
  "name": "pix2surf-tryon-ui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "dev:all": "node ./node_modules/concurrently/dist/bin/concurrently.js -n api,vite -c auto \"python server-local.py\" \"node ./node_modules/vite/bin/vite.js\"",
    "build": "node ./node_modules/typescript/lib/tsc.js --noEmit && node ./node_modules/vite/bin/vite.js build",
    "build:watch": "node ./node_modules/vite/bin/vite.js build --watch",
    "preview": "node ./node_modules/vite/bin/vite.js preview"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "@types/node": "^25.6.0",
    "@types/three": "^0.128.0",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "three": "^0.128.0"
  }
}
